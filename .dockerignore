# Keep the build context tiny — only go.mod/go.sum, server.go, dashboard.html
# and docker-entrypoint.sh are needed to build the image.
.git
.gitignore
*.md

# macOS preview tool + its build artifacts (not used in the container)
viewer.swift
.viewer
Makefile
.tool-versions

# Runtime / local-only files
photos/
uploads/
# The phone uploader is a separate Cloudflare Worker
uploader/
*.png
trmnl-*.html
devices.json
.env
.env.example

# Build outputs (the image builds its own binary, and make deploy's OCI layout)
server
trmnl
.oci

.DS_Store
