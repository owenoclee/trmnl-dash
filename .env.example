# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Weather location (Open-Meteo — find coords at open-meteo.com)
TRMNL_LAT=
TRMNL_LON=
TRMNL_LOCATION=

# Prometheus for the left column's charts; unset → empty charts.
# TRMNL_PROMETHEUS_URL=http://localhost:19090

# `make deploy` (see k8s/README.md): a script taking <oci-layout-dir> <repo:tag>
# that pushes the image to the registry your cluster pulls from.
# PUSH_IMAGE=~/code/homeops/hosts/sloppi/zot/push-image.sh
